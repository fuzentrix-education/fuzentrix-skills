{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzentrix-education/fuzentrix-skills/contracts/animation-spec-1.schema.json",
  "title": "Fuzentrix Animation Spec 1.x",
  "description": "editor_kit/animations/<video>_<event>_<template>/spec.json: one animation of a Video, as fz-visuals hands it to the Video Editor and the motion-animation workflow. Paths are relative to the animation's folder. Coordinates are pixels on the canvas, [x, y, width, height]. A reader rejects a spec whose major version it does not know; minor versions only add fields.",
  "type": "object",
  "required": ["spec_version", "generator", "video", "event", "brand", "canvas", "timing", "elements", "steps", "storyboard"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "generator": {
      "type": "object",
      "required": ["skill_version"],
      "properties": {"skill_version": {"type": "string"}}
    },
    "video": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}}
    },
    "event": {
      "type": "object",
      "required": ["id", "segment", "template", "layout", "trigger", "description", "editor_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]+-E[0-9]+$"},
        "segment": {"type": "string", "pattern": "^S[0-9]+$"},
        "template": {"type": "string", "description": "An Animation Template: a structural one (flow, flowchart, table_build, …), an illustrated one (character_scene, concept_reveal, transform_morph) or custom."},
        "layout": {"type": ["string", "null"], "description": "How the Visual Event shares the frame with the Instructor: fullscreen_cutaway, overlay or beside_instructor."},
        "trigger": {"type": "string", "description": "The spoken words the animation starts on."},
        "description": {"type": "string"},
        "editor_note": {"type": "string"}
      }
    },
    "brand": {
      "type": "object",
      "required": ["id", "version", "source", "colors", "fonts", "motion"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "source": {"enum": ["attached", "default", "inherited"]},
        "colors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hex"}},
        "fonts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["family", "file"],
            "properties": {"family": {"type": "string"}, "file": {"type": ["string", "null"]}}
          }
        },
        "motion": {
          "type": "object",
          "properties": {
            "easing": {"type": "object", "additionalProperties": {"type": "string"}},
            "durations": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
            "stagger": {"type": "number", "minimum": 0},
            "entrances": {"type": "object", "additionalProperties": {"$ref": "#/$defs/entrance"}}
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps", "safe_area", "presenter_area"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1},
        "safe_area": {"$ref": "#/$defs/box", "description": "Where the animation is drawn, for its layout."},
        "presenter_area": {"$ref": "#/$defs/box", "description": "Where the Instructor stands: nothing is drawn here."}
      }
    },
    "timing": {
      "type": "object",
      "required": ["basis", "words_per_minute", "event_start_sec", "duration_sec"],
      "properties": {
        "basis": {"enum": ["estimated_wpm", "transcript"], "description": "estimated_wpm: times are estimated from the speaking rate; place each step on its trigger in the recording."},
        "words_per_minute": {"type": "number", "exclusiveMinimum": 0},
        "event_start_sec": {"type": "number", "minimum": 0},
        "duration_sec": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "elements": {
      "type": "array",
      "description": "One transparent full-frame layer per element, in stacking order (z 1 at the bottom). Empty for a custom animation.",
      "items": {
        "type": "object",
        "required": ["id", "role", "label", "z", "bbox", "source", "entrance", "files"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "description": "The kind of element: node, edge, label, header, line, character, illustration, text, arrow, …"},
          "label": {"type": "string"},
          "z": {"type": "integer", "minimum": 1},
          "bbox": {"$ref": "#/$defs/box"},
          "source": {"enum": ["code", "ai"]},
          "entrance": {"$ref": "#/$defs/entrance"},
          "files": {"$ref": "#/$defs/files"},
          "placeholder": {"type": "boolean", "description": "true: an AI element not generated yet, drawn as a labelled dashed box in its place."}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "trigger", "start_sec", "offset_sec", "duration_sec", "enter", "exit", "describe", "state"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "trigger": {"type": "string", "description": "Spoken words the step starts on; empty: spread evenly."},
          "start_sec": {"type": "number", "minimum": 0},
          "offset_sec": {"type": "number", "minimum": 0},
          "duration_sec": {"type": "number", "minimum": 0},
          "enter": {"type": "array", "items": {"type": "string"}, "description": "Element ids that appear in this step."},
          "exit": {"type": "array", "items": {"type": "string"}},
          "describe": {"type": "string", "description": "What appears, for a custom animation."},
          "state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/files"}], "description": "The whole frame after this step."}
        }
      }
    },
    "storyboard": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/files"}]}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "entrance": {"enum": ["cut", "fade", "fade_up", "pop", "draw", "wipe", "type", "slide_in"]},
    "files": {
      "type": "object",
      "minProperties": 1,
      "properties": {"svg": {"type": "string"}, "png": {"type": "string"}},
      "additionalProperties": false
    }
  }
}
